# Network configuration
NETWORK=mainnet
MAX_FEE_PER_GAS_GWEI=25
MIN_EOA_ETH=0.1

# RPC URL
MAINNET_RPC_URL=https://rpc.ankr.com/eth

# Dry run mode - set to "true" to log without sending transactions
DRY_RUN=false

# Skip merkl claim - set to "true" to skip the merkle tree reward claim
SKIP_MERKL_CLAIM=false

# Skip compound - set to "true" to claim rewards but skip the autocompound call
SKIP_COMPOUND=false

# Private key for the keeper wallet
PRIVATE_KEY=0x0
